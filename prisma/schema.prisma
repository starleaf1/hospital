generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  systemName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patients      Patient[]
  servicePoints ServicePoint[]
  encounters    Encounter[]
  users         User[]
  medicalNotes  MedicalNote[]
  invoices      Invoice[]
  tariffMasters TariffMaster[]
  invoiceItems  InvoiceItem[]
}

enum UserRole {
  SYSADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  CASHIER
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?  
  email        String     @unique
  passwordHash String
  name         String
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  medicalNotes MedicalNote[]
}

model Patient {
  id        String   @id @default(uuid())
  tenantId  String
  nik       String
  name      String
  birthDate DateTime
  gender    String
  createdAt DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  encounters Encounter[]

  @@unique([tenantId, nik])
}

enum ServicePointType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
}

model ServicePoint {
  id        String           @id @default(uuid())
  tenantId  String
  name      String
  type      ServicePointType

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  encounters Encounter[]
}

enum EncounterStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

model Encounter {
  id                   String          @id @default(uuid())
  tenantId             String
  patientId            String
  servicePointId       String
  status               EncounterStatus @default(WAITING)
  bpjsSepNumber        String?
  satusehatEncounterId String?
  createdAt            DateTime        @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  servicePoint ServicePoint @relation(fields: [servicePointId], references: [id])
  medicalNotes MedicalNote[]
  invoices     Invoice[]
}

model MedicalNote {
  id           String    @id @default(uuid())
  tenantId     String
  encounterId  String
  doctorId     String
  symptoms     String?
  diagnosis    String?
  prescription String?
  notes        String?
  createdAt    DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  encounter    Encounter @relation(fields: [encounterId], references: [id])
  doctor       User      @relation(fields: [doctorId], references: [id])
}

model ClinicalAction {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  tariffMasters TariffMaster[]
  invoiceItems  InvoiceItem[]
}

model TariffMaster {
  id               String         @id @default(uuid())
  tenantId         String
  clinicalActionId String
  insuranceType    String         // e.g. "BPJS", "MANDIRI"
  classType        String         // e.g. "KELAS_1", "VIP", "NON_KELAS"
  jasaSarana       Int
  jasaDokter       Int
  jasaPerawat      Int
  costBHP          Int
  totalTariff      Int

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  clinicalAction   ClinicalAction @relation(fields: [clinicalActionId], references: [id])

  @@unique([tenantId, clinicalActionId, insuranceType, classType])
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  encounterId   String
  status        String        @default("DRAFT")
  paymentMethod String?
  paidAt        DateTime?
  totalAmount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  encounter     Encounter     @relation(fields: [encounterId], references: [id])
  items         InvoiceItem[]
}

model InvoiceItem {
  id                 String         @id @default(uuid())
  tenantId           String
  invoiceId          String
  clinicalActionId   String
  actionName         String
  jasaSaranaSnapshot Int
  jasaDokterSnapshot Int
  totalPriceSnapshot Int
  createdAt          DateTime       @default(now())

  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  invoice            Invoice        @relation(fields: [invoiceId], references: [id])
  clinicalAction     ClinicalAction @relation(fields: [clinicalActionId], references: [id])
}

